Options -Indexes

<FilesMatch "^(config|bootstrap|schema)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|ini)$">
    Require all denied
</FilesMatch>

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"


# Preserve bearer authorization for PHP under CGI/FastCGI.
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
